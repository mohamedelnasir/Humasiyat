# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (0 = none). Needed for correct client IPs / rate limiting.
TRUST_PROXY=0
# Comma-separated list of allowed browser origins. Mobile apps send no Origin header and are unaffected.
CORS_ORIGINS=
ENABLE_DOCS=true

# ---- Database (Supabase PostgreSQL: use the direct or session-pooler connection string) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/humasiyat
DATABASE_SSL=false
# Optional PEM CA certificate to verify the server when DATABASE_SSL=true
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10

# ---- Auth (Phase 2) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Applied to local phone numbers like 0912345678 (Sudan = 249)
DEFAULT_PHONE_COUNTRY_CODE=249

# ---- Supabase Storage (Phase 5) — server-side only, NEVER ship to Flutter ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_PITCH_IMAGES=pitch-images
STORAGE_BUCKET_PAYMENT_RECEIPTS=payment-receipts
STORAGE_BUCKET_MANAGER_DOCUMENTS=manager-documents

# ---- Firebase Cloud Messaging (Phase 6) ----
# Service-account JSON, single line
FCM_SERVICE_ACCOUNT_JSON=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
# Credential endpoints, per 15 min: per IP+account, and per IP (carrier NAT shares IPs)
AUTH_RATE_LIMIT_MAX=10
AUTH_IP_RATE_LIMIT_MAX=100

# ---- Seeding the first Super Admin (npm run seed:admin) — set only when running the script ----
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PHONE=
# SEED_ADMIN_PASSWORD=
